# Voice-Pipeline 环境配置
# 复制为 .env 并填写

# ---- 翻译 (通用 OpenAI 兼容 API, 主引擎) ----
# DeepSeek API（兼容旧配置, 推荐用下面 VP_TRANSLATE_* 通用项）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 通用 OpenAI 兼容配置 (DeepSeek/通义/Kimi/GLM/SiliconFlow/Ollama 等, 优先级高于 DEEPSEEK_*)
# VP_TRANSLATE_API_KEY=sk-...
# VP_TRANSLATE_BASE_URL=https://api.deepseek.com   (通义用 https://dashscope.aliyuncs.com/compatible-mode/v1)
# VP_TRANSLATE_MODEL=deepseek-chat                 (或 qwen-max / glm-4-flash / moonshot-v1-8k)
# 本地离线兜底模型 (主引擎失败时自动降级; 免 key, 仅 en→zh, 首次自动下载 ~300MB)
# VP_TRANSLATE_LOCAL_MODEL=Helsinki-NLP/opus-mt-en-zh

# 模型根目录（优先本地 assets）
VP_MODELS=K:\视频翻译与配音\models
# ffmpeg 工具（可选, 缺省自动定位 {VP_MODELS}\ffmpeg\bin; 单独设置可覆盖）
# FFMPEG_PATH=K:\视频翻译与配音\models\ffmpeg\bin\ffmpeg.exe
# Qwen3-TTS 模型路径
QWEN3_TTS_MODEL=K:\HuggingFace\models\Qwen3-TTS-12Hz-1.7B-Base
# 参考音色最长秒数 (超长自动截取; 默认 12)
# VP_REF_SECONDS=12
# TTS 每批句数 (默认 12; 调大减少批次数可能提速, 过大 OOM/卡死, 过小接近逐句也可能卡死)
# VP_TTS_BATCH_SIZE=12
# 生成参数 (可选, 默认用 qwen_tts 默认; 留空不传)
# VP_TTS_TEMPERATURE=0.3
# VP_TTS_TOP_P=0.9
# VP_TTS_TOP_K=50
# VP_TTS_REPETITION_PENALTY=1.1

# ---- ASR (faster-whisper) ----
# 模型来源: 本地 models/faster-whisper 优先; 未找到时自动下载该 HF 仓库 (迁移部署用)
# VP_WHISPER_MODEL=Systran/faster-whisper-large-v3-turbo
# 计算精度 (默认 cuda=float16 / cpu=int8)
# VP_WHISPER_COMPUTE=float16
# 识别语言 (新闻场景建议 en, 免自动检测开销; 留空=自动检测)
# VP_ASR_LANG=en
# 专有名词词表 (新闻人名/地名/缩写, 注入 initial_prompt 提升识别准确率)
# VP_ASR_PROMPT=Trump, Biden, United Nations, WHO
# 热词 (faster-whisper hotwords, 逗号分隔; 比 prompt 更硬性, 强制候选词)
# VP_ASR_HOTWORDS=Trump, Biden
